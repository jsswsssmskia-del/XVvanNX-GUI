	-- CEK APAKAH PLANT BISA DI STEAL
	local function canSteal(prompt)
		if not prompt.Enabled then return false end
		if blacklist[prompt] then return false end
		if prompt:GetAttribute("Locked") == true then return false end
		if prompt.Parent and prompt.Parent:GetAttribute("Locked") == true then return false end
		
		local promptText = (prompt.ActionText.. prompt.ObjectText):lower()
		for _, keyword in pairs(SKIP_KEYWORDS) do
			if string.find(promptText, keyword) then
				return false
			end
		end
		
		return true
	end

	-- REALTIME HUNT
	local function huntAndSteal()
		if isStealing then return 0 end
		
		if not isNight() then
			StatusLabel.Text = T("STATUS_DAY")
			StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 0)
			return 0
		end
		
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return 0 end
		
		local closestPrompt = nil
		local closestDist = math.huge
		
		for _, obj in pairs(workspace:GetDescendants()) do
			if obj:IsA("ProximityPrompt") then
				local text = (obj.ActionText.. obj.ObjectText.. obj.Name):lower()
				if string.find(text, "steal") then
					if obj.Parent and obj.Parent:IsA("BasePart") and obj.Enabled then
						if not blacklist[obj] then
							if canSteal(obj) then
								local distance = (hrp.Position - obj.Parent.Position).Magnitude
								if distance < closestDist then
									closestDist = distance
									closestPrompt = obj
								end
							else
								blacklist[obj] = true
								skipCount = skipCount + 1
								StealCountLabel.Text = T("STOLEN")..": "..stealCount.."/"..MAX_STEAL.." | "..T("SKIP")..": "..skipCount
							end
						end
					end
				end
			end
		end
		
		if closestPrompt then
			isStealing = true
			local oldPos = hrp.CFrame
			local targetPos = closestPrompt.Parent.CFrame + Vector3.new(0, 3, 0)
			
			StatusLabel.Text = T("STATUS_TP").." "..math.floor(closestDist).." STUDS"
			StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
			
			hrp.CFrame = targetPos
			task.wait(0.05)
			
			local success = false
			pcall(function()
				fireproximityprompt(closestPrompt)
				success = true
			end)
			
			task.wait(0.2)
			for _, gui in pairs(PlayerGui:GetDescendants()) do
				if gui:IsA("TextLabel") and gui.Visible then
					local text = gui.Text:lower()
					if string.find(text, "owner is in their garden") or string.find(text, "you can't steal") then
						blacklist[closestPrompt] = true
						skipCount = skipCount + 1
						StealCountLabel.Text = T("STOLEN")..": "..stealCount.."/"..MAX_STEAL.." | "..T("SKIP")..": "..skipCount
						StatusLabel.Text = T("STATUS_OWNER")
						StatusLabel.TextColor3 = Color3.fromRGB(255, 150, 0)
						success = false
						break
					end
				end
			end
			
			if not success then
				blacklist[closestPrompt] = true
				skipCount = skipCount + 1
				StealCountLabel.Text = T("STOLEN")..": "..stealCount.."/"..MAX_STEAL.." | "..T("SKIP")..": "..skipCount
			end
			
			task.wait(0.1)
			hrp.CFrame = oldPos
			
			isStealing = false
			
			if success then
				stealCount = stealCount + 1
				StealCountLabel.Text = T("STOLEN")..": "..stealCount.."/"..MAX_STEAL.." | "..T("SKIP")..": "..skipCount
			end
			
			if stealCount >= MAX_STEAL then
				StatusLabel.Text = "Status: RETURNING..."
				StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
				task.wait(0.3)
				returnToGarden()
				stealCount = 0
				skipCount = 0
				table.clear(blacklist)
				StealCountLabel.Text = T("STOLEN")..": 0/"..MAX_STEAL.." | "..T("SKIP")..": 0"
				task.wait(3)
			end
			
			return success and 1 or 0
		end
		return 0
	end

	-- AUTO HIT THIEF LOGIC
	local function hitThief()
		if not AutoHit then return end
		if not gardenPosition then return end
		
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		
		local humanoid = char:FindFirstChild("Humanoid")
		if not humanoid then return end
		
		-- CARI PLAYER LAIN DI GARDEN KITA
		for _, plr in pairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character then
				local theirHRP = plr.Character:FindFirstChild("HumanoidRootPart")
				local theirHum = plr.Character:FindFirstChild("Humanoid")
				if theirHRP and theirHum and theirHum.Health > 0 then
					-- CEK KALO DEKET GARDEN KITA (50 STUDS)
					local dist = (theirHRP.Position - gardenPosition.Position).Magnitude
					if dist < 50 then
						-- EQUIP SHOVEL
						local shovel = LocalPlayer.Backpack:FindFirstChild("Shovel") or char:FindFirstChild("Shovel")
						if shovel then
							humanoid:EquipTool(shovel)
							task.wait(0.1)
							
							-- TP KE MALING + PUKUL
							local oldPos = hrp.CFrame
							hrp.CFrame = theirHRP.CFrame * CFrame.new(0, 0, 3)
							StatusLabel.Text = T("STATUS_HIT").." "..plr.Name
							StatusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
							
							-- SPAM CLICK BUAT PUKUL
							for i = 1, 5 do
								shovel:Activate()
								task.wait(0.1)
							end
							
							task.wait(0.5)
							hrp.CFrame = oldPos
						end
						break
					end
				end
			end
		end
	end


local function runWaktu()

	if player.PlayerGui:FindFirstChild("007n7_txt | WAKTU") then return end

	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")

	local timeStopped = false
	local connection
	local frozenData = {}

	local gui = Instance.new("ScreenGui", player.PlayerGui)
	gui.Name = "007n7_txt | WAKTU"

	local frame = Instance.new("Frame", gui)
	frame.Size = UDim2.new(0,180,0,80)
	frame.Position = UDim2.new(0,50,0,50)
	frame.BackgroundColor3 = Color3.fromRGB(0,200,0)
	frame.BorderColor3 = Color3.fromRGB(255,0,0)
	frame.BorderSizePixel = 4
	frame.Active = true
	frame.Draggable = true

	local button = Instance.new("TextButton", frame)
	button.Size = UDim2.new(0.8,0,0,40)
	button.Position = UDim2.new(0.1,0,0.25,0)
	button.Text = "TIME STOP: OFF"
	button.BackgroundColor3 = Color3.fromRGB(0,200,0)
	button.TextColor3 = Color3.new(1,1,1)

	local function startTimeStop()
		if timeStopped then return end
		timeStopped = true
		
		frozenData = {}
		for _, plr in pairs(Players:GetPlayers()) do
			if plr ~= player then
				local char = plr.Character
				if char and char:FindFirstChild("HumanoidRootPart") then
					frozenData[plr] = char.HumanoidRootPart.CFrame
				end
			end
		end
		
		connection = RunService.RenderStepped:Connect(function()
			for plr, cf in pairs(frozenData) do
				local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
				if root then
					root.CFrame = cf
				end
			end
		end)
	end

	local function stopTimeStop()
		timeStopped = false
		if connection then connection:Disconnect() end
	end

	button.MouseButton1Click:Connect(function()
		if timeStopped then
			stopTimeStop()
			button.Text = "TIME STOP: OFF"
		else
			startTimeStop()
			button.Text = "TIME STOP: ON"
		end
	end)

end


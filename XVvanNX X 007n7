local function startTimeStop()
	if timeStopped then return end
	timeStopped = true
	
	-- Freeze players visually
	frozenData = {}
	for _, plr in pairs(Players:GetPlayers()) do
		if plr ~= player then
			local char = plr.Character
			if char and char:FindFirstChild("HumanoidRootPart") then
				frozenData[plr] = char.HumanoidRootPart.CFrame
			end
		end
	end
	
	-- Change sky to green
	local sky = workspace:FindFirstChildOfClass("Sky")
	if sky then
		local tween = TweenService:Create(sky, TweenInfo.new(1), {
			SkyboxBkColor=Color3.fromRGB(0,255,0),
			SkyboxDnColor=Color3.fromRGB(0,255,0),
			SkyboxFtColor=Color3.fromRGB(0,255,0),
			SkyboxLfColor=Color3.fromRGB(0,255,0),
			SkyboxRtColor=Color3.fromRGB(0,255,0),
			SkyboxUpColor=Color3.fromRGB(0,255,0)
		})
		tween:Play()
	end
	
	-- Update loop
	connection = RunService.RenderStepped:Connect(function()
		for plr, cf in pairs(frozenData) do
			local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
			if root then
				root.CFrame = cf
			end
		end
		
		local head = player.Character and player.Character:FindFirstChild("Head")
		if head then
			pointer.CFrame = head.CFrame * CFrame.new(0,2.5,0) * CFrame.Angles(0, tick() % 6.28, 0)
		end
	end)
end

local function stopTimeStop()
	timeStopped = false
	if connection then connection:Disconnect() end
	pointer.CFrame = CFrame.new(0,9999,0)
end

